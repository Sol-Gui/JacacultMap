PORT=3000 # Porta em que o servidor Express escuta

DATABASE_URL_CLUSTER_0=mongodb+srv://<user>:<password>@<cluster>.mongodb.net # URL de conexão com o MongoDB Atlas (cluster principal)
DB_NAME=jacacultmap # Nome do banco de dados dentro do cluster

JWT_SECRET=change-me-jwt-secret # Segredo usado para assinar os JWTs de autenticação
EXPRESS_SESSION_SECRET=change-me-session-secret # Segredo da sessão do Express

DEVELOPMENT_URL_BACKEND=http://localhost:3000 # URL do backend em desenvolvimento
DEVELOPMENT_URL_FRONTEND=http://localhost:8081 # URL do frontend em desenvolvimento
PRODUCTION_URL_FRONTEND= # URL do frontend em produção (ex: https://jacacultmap-app.vercel.app)

GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com # Credencial OAuth do Google
GOOGLE_CLIENT_SECRET=<your-google-client-secret> # Segredo do cliente OAuth do Google
DEBUG_OAUTH=false # Estado para debug do google-auth
